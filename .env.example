# Required for production. A random value of at least 32 bytes is recommended.
SECRET_KEY=replace-with-a-random-production-secret

# development, test, or production
ENVIRONMENT=development

# Optional: SQLite is used locally when DATABASE_URL is not set.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional cookie/session settings.
SESSION_MAX_AGE=3600
# COOKIE_SECURE=true
